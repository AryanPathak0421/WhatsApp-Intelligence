# Production variables for docker-compose.yml. Easiest path:  scripts/gen-secrets.sh   (writes .env with fresh random secrets)
# Never commit .env. Never reuse these across environments.

PUBLIC_URL=https://intel.example.com        # the browser-facing origin (CORS allow-list)
HTTP_PORT=80
HTTPS_PORT=443

POSTGRES_PASSWORD=                          # openssl rand -hex 24
REDIS_PASSWORD=                             # openssl rand -hex 24
JWT_ACCESS_SECRET=                          # openssl rand -hex 32  (>= 32 chars, startup fails otherwise)
JWT_REFRESH_SECRET=                         # openssl rand -hex 32
FIELD_ENCRYPTION_KEY=                       # openssl rand -hex 32  (exactly 64 hex chars). LOSING IT = encrypted uploads/phone numbers unreadable. Back it up separately.
AI_ENGINE_TOKEN=                            # openssl rand -hex 24  (service-to-service secret between backend and AI engine)

EMBED_MODEL=intfloat/multilingual-e5-small  # or "hashing" for a tiny dependency-free fallback; weights come from `model-fetch`
CLASSIFIER_PATH=                            # optional explicit classifier file; normally leave empty and use the model registry
# MODEL_REGISTRY_DIR=/models/registry       # set to serve the PRODUCTION classifier from the registry (see docs/MODEL_LIFECYCLE.md)
# PREDICTION_LOG=/models/predictions.jsonl  # drift-monitoring log (labels + confidences only, never message text)

# Resource limits (defaults shown)
# AI_MEM_LIMIT=6g
# BACKEND_MEM_LIMIT=1g
# WORKER_MEM_LIMIT=1g

# Backups (docker compose --profile backup up -d)
# BACKUP_DIR=./backups
# BACKUP_KEEP_DAYS=14

# --- Local development only (no docker-compose): see README.md ---
# DATABASE_URL=postgresql://wa:wa_dev_pw@localhost:15432/wa_intel
# QUEUE_MODE=inline           # no Redis: jobs run in-process

# In-app chat
# ANALYSIS_DEBOUNCE_MS=30000   # analyse a project once the conversation has been quiet this long
# FRONTEND_URL=https://intel.example.com   # base of links in invitation e-mails (must be reachable by the recipient)

# Outgoing e-mail for chat invitations (disabled unless SMTP_HOST is set). Gmail: smtp.gmail.com, 465, an App Password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=you@example.com
# SMTP_PASS=                   # app password; never commit it
# SMTP_FROM=Project Intelligence <you@example.com>
# INVITE_TTL_DAYS=7
